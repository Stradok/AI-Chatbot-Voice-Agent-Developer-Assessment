# Required: LLM via OpenRouter
OPENROUTER_API_KEY=
# Optional: comma-separated models tried in order. Default = two free OpenRouter models
# (google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free). Paid example: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=

# Voice (LiveKit Cloud project: Settings > API keys)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Refresh + admin endpoints (Vercel Cron sends this as a Bearer token)
CRON_SECRET=
# Vercel > Project > Settings > Git > Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=

# Optional persistent logging of gaps/leads (Vercel Upstash integration sets these)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional free data sink: Google Apps Script web app URL (docs/google-sheets-script.gs)
SHEETS_WEBHOOK_URL=

# Shared secret for the LiveKit Agent Builder agent (maya): HTTP tool /api/ask and call-end /api/call-end
VOICE_TOOL_TOKEN=
